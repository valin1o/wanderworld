# WanderWorld Server — Environment Variables
# Copy this file to .env and fill in all values before running the server.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (format: mongodb+srv://user:pass@cluster.mongodb.net/dbname)
MONGODB_URI=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use test-mode keys (sk_test_...)
STRIPE_SECRET_KEY=
# From: stripe listen --forward-to localhost:4000/api/bookings/webhook
STRIPE_WEBHOOK_SECRET=

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend URL — must match exactly (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173
